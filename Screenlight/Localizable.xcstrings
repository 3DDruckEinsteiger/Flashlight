    "Slowly drifts through all colors.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتنقل ببطء بين جميع الألوان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে ধীরে সব রঙের মধ্য দিয়ে ঘোরে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre lentament tots els colors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalu prochází všemi barvami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glider langsomt gennem alle farver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandert langsam durch alle Farben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περνά αργά από όλα τα χρώματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly drifts through all colours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly drifts through all colours."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly drifts through all colours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre lentamente todos los colores."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre lentamente todos los colores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liukuu hitaasti kaikkien värien läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe lentement par toutes les couleurs."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe lentement par toutes les couleurs."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ધીમે ધીમે બધા રંગોમાંથી પસાર થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עובר לאט בין כל הצבעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे सभी रंगों से होकर गुज़रता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polako prolazi kroz sve boje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassan végighalad az összes színen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berganti perlahan melewati semua warna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa lentamente per tutti i colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカラーをゆっくりと移り変わります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಧಾನವಾಗಿ ಎಲ್ಲ ಬಣ್ಣಗಳ ಮೂಲಕ ಸಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 색상으로 천천히 바뀝니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ നിറങ്ങളിലൂടെയും പതുക്കെ നീങ്ങുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व रंगांमधून हळूहळू फिरतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih perlahan-lahan melalui semua warna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Glir sakte gjennom alle fargene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glijdt langzaam door alle kleuren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧୀରେ ଧୀରେ ସବୁ ରଙ୍ଗ ଦେଇ ଗତି କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੌਲੀ-ਹੌਲੀ ਸਾਰੇ ਰੰਗਾਂ ਵਿੱਚੋਂ ਲੰਘਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powoli przechodzi przez wszystkie kolory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa lentamente por todas as cores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorre lentamente todas as cores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trece lent prin toate culorile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно проходит через все цвета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaly prechádza všetkými farbami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Počasi prehaja skozi vse barve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glider långsamt genom alla färger."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா நிறங்களிலும் மெதுவாக மாறிச் செல்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని రంగుల గుండా నెమ్మదిగా సాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่อยๆ เปลี่ยนไล่ไปจนครบทุกสี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm renkler arasında yavaşça dolaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільно проходить через усі кольори."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آہستہ آہستہ تمام رنگوں سے گزرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển chậm rãi qua tất cả các màu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有颜色之间缓缓流转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有顏色之間緩緩變換。"
          }
        }
      }
    },

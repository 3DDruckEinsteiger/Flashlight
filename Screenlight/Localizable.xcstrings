    "Warm, softly flickering light.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضوء دافئ يتراقص بنعومة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উষ্ণ, মৃদু কাঁপতে থাকা আলো।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llum càlida amb un parpelleig suau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplé, jemně mihotavé světlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmt, blidt blafrende lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes, sanft flackerndes Licht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θερμό φως που τρεμοπαίζει απαλά."
          }
        },

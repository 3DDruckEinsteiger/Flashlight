    "Double tap to show or hide the controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين لإظهار عناصر التحكم أو إخفائها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোল দেখাতে বা লুকাতে দুবার ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dues vegades per mostrar o amagar els controls."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojím klepnutím zobrazíte nebo skryjete ovládání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk to gange for at vise eller skjule betjeningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen blendet die Bedienung ein oder aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε δύο φορές για εμφάνιση ή απόκρυψη των χειριστηρίων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to show or hide the controls."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to show or hide the controls."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to show or hide the controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para mostrar u ocultar los controles."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para mostrar u ocultar los controles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tai kätke säätimet kaksoisnapauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour afficher ou masquer les commandes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour afficher ou masquer les commandes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંટ્રોલ બતાવવા કે છુપાવવા માટે બે વાર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו פעמיים כדי להציג או להסתיר את הפקדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोल दिखाने या छिपाने के लिए डबल टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite za prikaz ili skrivanje kontrola."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupla koppintással megjeleníthetők vagy elrejthetők a vezérlők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk menampilkan atau menyembunyikan kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per mostrare o nascondere i controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでコントロールの表示／非表示を切り替えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಯಂತ್ರಣಗಳನ್ನು ತೋರಿಸಲು ಅಥವಾ ಮರೆಮಾಡಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이중 탭하여 제어기를 표시하거나 가립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിയന്ത്രണങ്ങൾ കാണിക്കാനോ മറയ്ക്കാനോ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रणे दाखवण्यासाठी किंवा लपवण्यासाठी दोनदा टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwiketik untuk menunjukkan atau menyembunyikan kawalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å vise eller skjule kontrollene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik dubbel om de bediening te tonen of te verbergen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କଣ୍ଟ୍ରୋଲ୍ ଦେଖାଇବା କିମ୍ବା ଲୁଚାଇବା ପାଇଁ ଦୁଇଥର ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਟਰੋਲ ਦਿਖਾਉਣ ਜਾਂ ਲੁਕਾਉਣ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie, aby pokazać lub ukryć sterowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para mostrar ou ocultar os controles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para mostrar ou ocultar os controlos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați de două ori pentru a afișa sau a ascunde comenzile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь, чтобы показать или скрыть элементы управления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím zobrazíte alebo skryjete ovládanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvakrat tapnite, da prikažete ali skrijete kontrolnike."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltryck för att visa eller gömma reglagen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டுப்பாடுகளைக் காட்ட அல்லது மறைக்க இருமுறை தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంట్రోల్‌లను చూపడానికి లేదా దాచడానికి రెండుసార్లు ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อแสดงหรือซ่อนตัวควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetimleri göstermek veya gizlemek için çift dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкніть, щоб показати або сховати елементи керування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنٹرولز دکھانے یا چھپانے کے لیے دو بار تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hai lần để hiện hoặc ẩn các điều khiển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下可显示或隐藏控制项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下來顯示或隱藏控制項目。"
          }
        }
      }
    },

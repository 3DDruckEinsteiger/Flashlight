          "stringUnit": {
            "state": "translated",
            "value": "Lumină caldă, care pâlpâie ușor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёплый, мягко мерцающий свет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplé, jemne mihotavé svetlo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Topla, nežno migetajoča svetloba."

        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmt, mjukt fladdrande ljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெதுவெதுப்பான, மெல்ல அசையும் ஒளி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెచ్చని, మెల్లగా మినుకుమనే లైట్."
          }
        },
        "th": {
          "stringUnit": {

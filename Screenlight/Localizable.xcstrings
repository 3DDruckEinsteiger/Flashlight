          "stringUnit": {
            "state": "translated",
            "value": "گرم، ہلکی سی ٹمٹماتی روشنی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng ấm, lung linh nhè nhẹ."

            "value": "મોર્સ કોડમાં સંકટ સંકેત SOS ઝબકાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהבהב את אות המצוקה SOS בקוד מורס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोर्स कोड में संकट संकेत SOS फ़्लैश करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje signal za pomoć SOS Morseovim kodom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az SOS vészjelet villogja morzekóddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengedipkan sinyal darurat SOS dalam kode Morse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette il segnale di soccorso SOS in codice Morse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遭難信号SOSをモールス符号で点滅させます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೋರ್ಸ್ ಕೋಡ್‌ನಲ್ಲಿ SOS ಅಪಾಯ ಸಂಕೇತವನ್ನು ಮಿನುಗಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조난 신호 SOS를 모스 부호로 깜박입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഴ്സ് കോഡിൽ SOS അപായസൂചന മിന്നിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोर्स कोडमध्ये SOS हा संकट संकेत चमकवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengelipkan isyarat kecemasan SOS dalam kod Morse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",

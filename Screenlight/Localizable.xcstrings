    "Hides the controls. Tap the light to show them again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي عناصر التحكم. اضغط على الضوء لإظهارها مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোল লুকিয়ে রাখে। আবার দেখাতে আলোতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaga els controls. Toca la llum per tornar-los a mostrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje ovládání. Klepnutím na světlo ho znovu zobrazíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjuler betjeningen. Tryk på lyset for at vise den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Bedienung aus. Tippe auf das Licht, um sie wieder einzublenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρύβει τα χειριστήρια. Αγγίξτε το φως για να εμφανιστούν ξανά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the controls. Tap the light to show them again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the controls. Tap the light to show them again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the controls. Tap the light to show them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los controles. Toca la luz para volver a mostrarlos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los controles. Toca la luz para volver a mostrarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kätkee säätimet. Tuo ne takaisin napauttamalla valoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les commandes. Touchez la lumière pour les réafficher."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les commandes. Touchez la lumière pour les afficher de nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંટ્રોલ છુપાવે છે. ફરી બતાવવા માટે લાઇટ પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסתיר את הפקדים. הקישו על האור כדי להציג אותם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोल छिपाता है। उन्हें फिर से दिखाने के लिए लाइट पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriva kontrole. Dodirnite svjetlo za njihov ponovni prikaz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejti a vezérlőket. A fényre koppintva újra megjelennek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan kontrol. Ketuk lampu untuk menampilkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde i controlli. Tocca la luce per mostrarli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールを隠します。もう一度表示するにはライトをタップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಯಂತ್ರಣಗಳನ್ನು ಮರೆಮಾಡುತ್ತದೆ. ಮತ್ತೆ ತೋರಿಸಲು ಬೆಳಕಿನ ಮೇಲೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어기를 가립니다. 다시 표시하려면 조명을 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിയന്ത്രണങ്ങൾ മറയ്ക്കുന്നു. വീണ്ടും കാണിക്കാൻ വെളിച്ചത്തിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रणे लपवतो. ती पुन्हा दाखवण्यासाठी प्रकाशावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan kawalan. Ketik lampu untuk menunjukkannya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjuler kontrollene. Trykk på lyset for å vise dem igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt de bediening. Tik op het licht om deze weer te tonen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କଣ୍ଟ୍ରୋଲ୍ ଲୁଚାଏ। ପୁଣି ଦେଖାଇବାକୁ ଆଲୋକ ଉପରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਟਰੋਲ ਲੁਕਾਉਂਦਾ ਹੈ। ਦੁਬਾਰਾ ਦਿਖਾਉਣ ਲਈ ਲਾਈਟ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywa sterowanie. Stuknij w światło, aby znów je pokazać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os controles. Toque na luz para mostrá-los de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os controlos. Toque na luz para voltar a mostrá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde comenzile. Apăsați pe lumină pentru a le afișa din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает элементы управления. Коснитесь света, чтобы показать их снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje ovládanie. Klepnutím na svetlo ho znova zobrazíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrije kontrolnike. Tapnite luč, da jih znova prikažete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gömmer reglagen. Tryck på ljuset för att visa dem igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டுப்பாடுகளை மறைக்கிறது. மீண்டும் காட்ட ஒளியைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంట్రోల్‌లను దాస్తుంది. మళ్లీ చూపడానికి లైట్‌పై ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนตัวควบคุม แตะที่ไฟเพื่อแสดงอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetimleri gizler. Yeniden göstermek için ışığa dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховає елементи керування. Торкніть світло, щоб показати їх знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنٹرولز چھپا دیتا ہے۔ انہیں دوبارہ دکھانے کے لیے روشنی پر تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn các điều khiển. Chạm vào đèn để hiện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏控制项。轻点灯光可再次显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏控制項目。點一下燈光即可再次顯示。"
          }
        }
      }
    },

            "value": "Luz cálida con un suave parpadeo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz cálida que parpadea suavemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämmin, pehmeästi lepattava valo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière chaude au doux vacillement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière chaude qui vacille doucement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગરમ, હળવેથી ઝબૂકતી લાઇટ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אור חם שמהבהב בעדינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्म, हल्की टिमटिमाती रोशनी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplo svjetlo koje nježno treperi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meleg, lágyan pislákoló fény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya hangat yang berkelip lembut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce calda dal tremolio delicato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしくゆらめく、あたたかな光。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೆಚ್ಚಗಿನ, ಮೃದುವಾಗಿ ಮಿನುಗುವ ಬೆಳಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻하고 은은하게 일렁이는 불빛."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഊഷ്മളവും മൃദുവായി മിന്നുന്നതുമായ വെളിച്ചം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उबदार, हळुवार लुकलुकणारा प्रकाश."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya hangat yang berkelip lembut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmt, mykt blafrende lys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, zacht flakkerend licht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉଷୁମ, ଧୀରେ ଧୀରେ ଥରୁଥିବା ଆଲୋକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿੱਘੀ, ਹੌਲੀ-ਹੌਲੀ ਟਿਮਟਿਮਾਉਂਦੀ ਲਾਈਟ।"
          }
        },
        "pl": {
          "stringUnit": {
